# Dart / Flutter
# Volontairement non versionné : l'application se construit avec les versions
# résolues au moment de la compilation, et le fichier se régénère à chaque
# `flutter pub get`. Versionné, il salirait l'arbre à chaque commande.
pubspec.lock
.dart_tool/
.packages
.pub/
.pub-cache/
build/
coverage/
.flutter-plugins
.flutter-plugins-dependencies

# IDE
.idea/
*.iml
.vscode/

# Android
android/.gradle/
android/local.properties
# Signature de distribution : ni la clé ni ses mots de passe ne sont versionnés.
android/key.properties
*.jks
*.keystore
android/app/debug/
android/app/profile/
android/app/release/

# Native build artifacts
*.so
*.dll
*.dylib
*.a
*.o

# Secrets
.env
*.keystore
*.jks
key.properties

# OS
.DS_Store
Thumbs.db

# Traductions générées par `flutter gen-l10n`, relancé à chaque `flutter pub
# get` grâce à `generate: true`. Les sources sont les fichiers ARB voisins :
# verser les fichiers générés obligerait à les régénérer à la main et à les
# relire comme du code écrit, alors qu'ils n'en sont pas.
lib/l10n/app_localizations*.dart
