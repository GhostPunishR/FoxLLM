<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Déclinaison claire, appliquée par défaut. `@color/foxgpt_background` est
         redéfini dans values-night : les deux jeux de styles ne diffèrent donc
         que par la luminosité des icônes système.

         `NormalTheme` reprend la même couleur de fond que `LaunchTheme`, sinon
         le passage de la fenêtre de lancement à Flutter provoquerait un flash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/foxgpt_background</item>
        <item name="android:navigationBarColor">@color/foxgpt_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/foxgpt_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/foxgpt_background</item>
        <item name="android:navigationBarColor">@color/foxgpt_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
