<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Aucun écran de marque au lancement : la fenêtre affiche directement le
         fond de l'application, si bien que l'apparition du chat ne montre
         aucune transition. `NormalTheme` utilise la même couleur, sinon le
         passage de la fenêtre de lancement à Flutter provoquerait un flash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/foxgpt_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/foxgpt_background</item>
        <item name="android:navigationBarColor">@color/foxgpt_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/foxgpt_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/foxgpt_background</item>
        <item name="android:navigationBarColor">@color/foxgpt_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
