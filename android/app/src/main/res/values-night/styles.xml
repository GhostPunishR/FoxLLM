<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Déclinaison sombre. Mêmes styles que values/, aux icônes système près :
         claires ici, sombres sur le fond crème. -->
    <style name="LaunchTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/foxgpt_background</item>
        <item name="android:navigationBarColor">@color/foxgpt_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@color/foxgpt_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/foxgpt_background</item>
        <item name="android:navigationBarColor">@color/foxgpt_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
