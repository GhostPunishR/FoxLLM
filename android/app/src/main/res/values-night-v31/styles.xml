<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Variante sombre du splash Android 12+. Ce dossier est nécessaire : le
         qualificatif `night` l'emporte sur `v31`, donc sans lui values-night/
         gagnerait en mode sombre et les attributs du splash seraient perdus. -->
    <style name="LaunchTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowSplashScreenBackground">@color/foxllm_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/fox_splash_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:statusBarColor">@color/foxllm_background</item>
        <item name="android:navigationBarColor">@color/foxllm_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
