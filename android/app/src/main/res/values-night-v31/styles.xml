<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- À partir d'Android 12, le système impose sa propre fenêtre de
         lancement : elle ne peut pas être désactivée, seulement neutralisée.
         On lui donne le fond de l'application et une icône entièrement
         transparente (`@drawable/splash_icon`), ce qui ne laisse qu'un aplat
         de la couleur du chat, donc aucun écran de marque visible.

         `windowSplashScreenIconBackgroundColor` est volontairement absent :
         défini, il dessinerait un disque derrière l'icône transparente. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/foxgpt_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowSplashScreenBackground">#FF0B0B0B</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:statusBarColor">@color/foxgpt_background</item>
        <item name="android:navigationBarColor">@color/foxgpt_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
