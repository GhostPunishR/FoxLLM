<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 et antérieurs, qui ignorent `data_extraction_rules.xml`.
  Redondant avec `android:allowBackup="false"`, mais explicite : si la
  sauvegarde venait à être réactivée, rien ne partirait pour autant.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
