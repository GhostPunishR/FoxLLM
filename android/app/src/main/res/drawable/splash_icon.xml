<?xml version="1.0" encoding="utf-8"?>
<!-- Icône entièrement transparente utilisée par la fenêtre de lancement
     d'Android 12+, que le système impose et qui ne peut pas être désactivée.

     Les dimensions sont volontairement celles attendues par le système
     (240dp) : une icône hors gabarit peut être ignorée, auquel cas Android
     retombe sur l'icône du launcher — un renard sur fond blanc, donc
     exactement l'écran que l'on cherche à supprimer. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="240"
    android:viewportHeight="240">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h240v240h-240z" />
</vector>
